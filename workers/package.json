{
  "name": "japoint-api",
  "version": "1.0.0",
  "description": "JAPOINT Payment History API - Cloudflare Workers",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create japoint-payments",
    "db:init": "wrangler d1 execute japoint-payments --file=./schema.sql",
    "db:init:local": "wrangler d1 execute japoint-payments --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
