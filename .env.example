# ========================================
# JAPOINT デプロイ設定ファイル
# ========================================
#
# このファイルをコピーして .env ファイルを作成してください:
#   cp .env.example .env
#   nano .env
#
# ⚠️ 重要: .env ファイルは絶対にGitにコミットしないでください！
# ========================================

# ----------------------------------------
# 1. デプロイ用ウォレットの秘密鍵
# ----------------------------------------
# MetaMaskから取得: アカウント詳細 → 秘密鍵のエクスポート
# ⚠️ 絶対に公開しないでください！
#
# 例: 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ----------------------------------------
# 2. Sepolia RPC URL
# ----------------------------------------
# Alchemyで取得（無料）:
#   1. https://www.alchemy.com/ にアクセス
#   2. サインアップ
#   3. Create App → Chain: Ethereum, Network: Sepolia
#   4. View Key → HTTPS URLをコピー
#
# 例: https://eth-sepolia.g.alchemy.com/v2/abcd1234efgh5678ijkl
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_api_key_here

# ----------------------------------------
# 3. Etherscan APIキー（オプション）
# ----------------------------------------
# コントラクトの自動認証に使用（省略可能）
# https://etherscan.io/myapikey で取得
#
# 例: ABCD1234EFGH5678IJKL
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ----------------------------------------
# 4. 会社アドレス
# ----------------------------------------
# Transfer5/10からの手数料（0.5%/1%）を受け取るアドレス
# JAPointMintが受け取ったJPYDをこのアドレスに転送します
#
# 例: 0x70997970C51812dc3A010C7d01b50e0d17dc79C8
COMPANY_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8

# ----------------------------------------
# 5. ショップアドレス
# ----------------------------------------
# 決済金額の99%/99.5%を受け取るアドレス
# Transfer10/5がこのアドレスに売上を転送します
#
# 例: 0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
SHOP_ADDRESS=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC

# ----------------------------------------
# 6. 初期JPYD供給量（オプション）
# ----------------------------------------
# デフォルト: 10,000,000 JPYD（18桁）
# 変更する場合のみ設定してください
#
# 計算方法: 希望数量 × 10^18
# 例: 10,000,000 JPYD = 10000000000000000000000000
INITIAL_JPYD_SUPPLY=10000000000000000000000000

# ========================================
# 設定完了後の手順
# ========================================
#
# 1. Sepolia ETHを取得（まだの場合）:
#    https://sepoliafaucet.com/
#
# 2. デプロイ実行:
#    source .env
#    forge script script/DeployFullSystem.s.sol \
#      --rpc-url $SEPOLIA_RPC_URL \
#      --broadcast \
#      --verify \
#      -vvv
#
# 3. デプロイされたアドレスをメモ
#
# 4. 完了！
# ========================================
